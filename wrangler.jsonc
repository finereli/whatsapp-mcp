{
  // Pre-migration reference only. cf uses cloudflare.config.ts and wrangler.config.ts.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whatsapp-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Baileys needs three things workerd doesn't have. See "What to know before changing things" in the README.
  "alias": {
    "ws": "./src/ws-shim.ts",
    "lru-cache": "./src/lru-shim.ts",
    "whatsapp-rust-bridge": "./vendor/whatsapp-rust-bridge/index.js"
  },
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }],

  // One Durable Object holds the linked WhatsApp session and the message store (its SQLite).
  "durable_objects": { "bindings": [{ "name": "WA", "class_name": "WhatsAppStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WhatsAppStore"] }],

  // The OAuth provider's token store. Create it, then paste the id:
  //   npx wrangler kv namespace create OAUTH_KV
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],

  // First history import decodes a lot of protobuf; the default CPU budget is too small. Needs Workers Paid.
  "limits": { "cpu_ms": 300000 },

  // Daily pull, so WhatsApp's per-device queue never goes stale.
  "triggers": { "crons": ["0 4 * * *"] }

  // Sign-in defaults to a password: `npx wrangler secret put OWNER_PASSWORD` (12+ characters).
  //
  // Optional: your own domain instead of workers.dev.
  //   "routes": [{ "pattern": "whatsapp.example.com", "custom_domain": true }],
  //
  // Optional: sign in through a Google login service instead of a password.
  //   "vars": { "LOGIN_ORIGIN": "https://login.example.com", "OWNER_EMAIL": "you@example.com", "ALLOWED_ORIGINS": "https://whatsapp.example.com" }
}
