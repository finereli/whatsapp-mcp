{
  "name": "whatsapp-mcp",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/vendor-bridge.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:local": "wrangler deploy -c wrangler.local.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --no-warnings --import ./test/ts-resolve.mjs test/store.test.mts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.7.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "qrcode-generator": "^2.0.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261018.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.1"
  },
  "description": "A read-only MCP server over your own WhatsApp history, running on Cloudflare Workers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finereli/whatsapp-mcp.git"
