{
  "name": "whatsapp-mcp",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/vendor-bridge.mjs",
    "dev": "cf dev",
    "deploy": "cf deploy",
    "deploy:local": "cf deploy --mode private",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --no-warnings test/store.test.mts",
    "build": "cf build"
  },
  "dependencies": {
