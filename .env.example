# The public hostname your tunnel or proxy serves this on, over https.
PUBLIC_HOST=whatsapp.example.com
# 12+ characters. Locks your messages; there is no recovery.
OWNER_PASSWORD=
# Optional: 32+ random characters, enables GET /debug with an x-pin header.
PIN=
# Where the port is published on the host.
BIND=127.0.0.1
PORT=8787
# Optional: TIMEZONE=America/Sao_Paulo, DEFAULT_COUNTRY_CODE=55
